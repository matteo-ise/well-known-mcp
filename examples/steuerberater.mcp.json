{
  "version": "1.0",
  "name": "Steuerberater Muster GmbH",
  "description": "Offizieller MCP Endpoint für die Steuerkanzlei Muster. Bietet DATEV und ELSTER Integrationen für KI Agenten.",
  "endpoints": [
    {
      "url": "https://api.muster-steuer.de/mcp",
      "transport": "streamable-http",
      "authentication": "oauth2"
    }
  ],
  "capabilities": {
    "tools": ["datev_document_upload", "elster_status_check", "tax_consulting_scheduler"],
