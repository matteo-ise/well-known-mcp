  },
  "contact": {
    "email": "agent-ops@muster-steuer.de",
    "url": "https://muster-steuer.de/agent-info"
  },
  "policies": {
    "rate_limits": "100 req/min per agent",
    "terms_of_service": "https://muster-steuer.de/tos/agents",
    "privacy_policy": "https://muster-steuer.de/privacy"
  }
}
